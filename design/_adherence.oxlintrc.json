{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/sections/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Barlow))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Barlow."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|date|category|categoryTone|title|blurb|readTime|layout|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: image, date, category, categoryTone, title, blurb, readTime, layout, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='categoryTone'] > Literal[value!=/^(?:story|ai|engineering|experiment|life)$/]",
        "message": "<ArticleCard> categoryTone must be one of 'story' | 'ai' | 'engineering' | 'experiment' | 'life'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<ArticleCard> layout must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|showIcon|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, showIcon, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline-gold|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline-gold' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Capability'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<Capability> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|count|key|ref|className|style|children)$/]",
        "message": "<CategoryItem> doesn't accept that prop. Declared props: label, icon, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactMethod'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|style|key|ref|className|style|children)$/]",
        "message": "<ContactMethod> doesn't accept that prop. Declared props: icon, label, value, style."
      },
