        "selector": "JSXOpeningElement[name.name='CTABanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|blurb|cta|onAction|style|key|ref|className|style|children)$/]",
        "message": "<CTABanner> doesn't accept that prop. Declared props: icon, title, blurb, cta, onAction, style."
